+/* A reference run's frame (xemu-reference.c): the colour surface the game just drew, or else the one
+ * the display shows, read back whole. */
+static void reference_dump(NV2AState *d, uint32_t frame)
+{
+    PGRAPHGLState *r = d->pgraph.gl_renderer_state;
+    SurfaceBinding *surface = r->color_binding;
+    GLint width = 0, height = 0;
+    uint8_t *pixels;
+
+    if (surface == NULL || !surface->color) {
+        VGADisplayParams params;
+        d->vga.get_params(&d->vga, &params);
+        surface = pgraph_gl_surface_get_within(d, d->pcrtc.start + params.line_offset);
+    }
+    if (surface == NULL || !surface->color) {
+        return;
+    }
+    glBindTexture(GL_TEXTURE_2D, surface->gl_buffer);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &width);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &height);
+    if (width <= 0 || height <= 0) {
+        return;
+    }
+    pixels = g_malloc((size_t)width * height * 4);
+    glGetTexImage(GL_TEXTURE_2D, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+    xemu_reference_dump(frame, width, height, pixels, false);
+    g_free(pixels);
+}
+
 static void pgraph_gl_flip_stall(NV2AState *d)
 {
+    uint32_t frame;
+
     NV2A_GL_DFRAME_TERMINATOR();
     glFinish();
+    if (xemu_reference_flip(&frame)) {
+        reference_dump(d, frame);
+    }
 }
 
 static void pgraph_gl_flush(NV2AState *d)
