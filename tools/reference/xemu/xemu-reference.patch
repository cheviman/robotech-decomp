+/*
+ * A reference run's hook at the instruction about to run (ui/xemu-reference.c): a present counted, or
+ * the game's function answered as the port answers it and returned from, its stdcall arguments popped.
+ */
+void helper_xemu_reference_hook(CPUX86State *env)
+{
+    uintptr_t ra = GETPC();
+    uint32_t esp = env->regs[R_ESP];
+    uint32_t out, pop;
+    uint64_t value;
+    uint8_t state[XEMU_REFERENCE_PAD_STATE];
+
+    switch (xemu_reference_hook_at(env->eip)) {
+    case XEMU_REFERENCE_HOOK_SWAP:
+        xemu_reference_swap();
+        return;
+    case XEMU_REFERENCE_HOOK_COUNTER:
+        value = xemu_reference_counter();
+        out = cpu_ldl_data_ra(env, esp + 4, ra);
+        if (out) {
+            cpu_stq_data_ra(env, out, value, ra);
+        }
+        env->regs[R_EAX] = 1;
+        pop = 4;
+        break;
+    case XEMU_REFERENCE_HOOK_TICKS:
+        env->regs[R_EAX] = xemu_reference_ticks();
+        pop = 0;
+        break;
+    case XEMU_REFERENCE_HOOK_DATE:
+        value = xemu_reference_date();
+        out = cpu_ldl_data_ra(env, esp + 4, ra);
+        if (out) {
+            cpu_stq_data_ra(env, out, value, ra);
+        }
+        pop = 4;
+        break;
+    case XEMU_REFERENCE_HOOK_PAD:
+        xemu_reference_pad_state(state);
+        out = cpu_ldl_data_ra(env, esp + 8, ra);
+        for (int i = 0; out && i < XEMU_REFERENCE_PAD_STATE; i++) {
+            cpu_stb_data_ra(env, out + i, state[i], ra);
+        }
+        env->regs[R_EAX] = 0;               /* ERROR_SUCCESS */
+        pop = 8;
+        break;
+    default:
+        return;
+    }
+    env->eip = cpu_ldl_data_ra(env, esp, ra);
+    env->regs[R_ESP] = esp + 4 + pop;
+    cpu_loop_exit(env_cpu(env));
+}
+#endif
