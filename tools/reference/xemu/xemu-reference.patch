@@ -0,0 +1,75 @@
+/*
+ * xemu as a reference for a game's port: a pad script by frame, the frames dumped, an exit frame, and the
+ * game's clocks and pad answered as the port answers them
+ *
+ * Copyright (c) 2026 Sebastian Toyos
+ *
+ * This program is free software; you can redistribute it and/or modify it under the terms of the
+ * GNU General Public License as published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ */
+#ifndef XEMU_REFERENCE_H
+#define XEMU_REFERENCE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The game's functions a reference run answers as the port does (XEMU_REFERENCE_HOOKS). */
+enum {
+    XEMU_REFERENCE_HOOK_NONE,
+    XEMU_REFERENCE_HOOK_SWAP,       /* its present: a frame, counted; the function then runs */
+    XEMU_REFERENCE_HOOK_COUNTER,    /* QueryPerformanceCounter(pCount), stdcall */
+    XEMU_REFERENCE_HOOK_TICKS,      /* GetTickCount() */
+    XEMU_REFERENCE_HOOK_DATE,       /* GetSystemTimeAsFileTime(pTime), stdcall */
+    XEMU_REFERENCE_HOOK_PAD,        /* XInputGetState(hDevice, pState), stdcall */
+};
+
+/* An XINPUT_STATE: the packet number, then XINPUT_GAMEPAD (wButtons, bAnalogButtons[8], the sticks). */
+#define XEMU_REFERENCE_PAD_STATE 22
+
+/* Whether a run is a reference's (XEMU_REFERENCE_DIR set). */
+bool xemu_reference_active(void);
+
+/* At the guest's flip (NV097_FLIP_STALL): counts it, as the n-th frame the game presents; true when
+ * that frame is to be dumped, its number in *frame. */
+bool xemu_reference_flip(uint32_t *frame);
+
+/* Writes a frame, RGBA rows from the top or from the bottom, as XEMU_REFERENCE_DIR/fNNNNN.bmp. */
+void xemu_reference_dump(uint32_t frame, unsigned width, unsigned height, const uint8_t *rgba,
+                         bool bottom_up);
+
+/* A report the emulated pad on 'port' hands the game over USB (its digital buttons, its A): counted, and
+ * logged when it changes. */
+void xemu_reference_report(int port, uint16_t buttons, uint8_t a);
+
+/* A controller bound to a port, or unbound (name NULL): logged. */
+void xemu_reference_bound(int port, const char *name);
+
+/* The pad script's buttons and axes for the frame the game is at, over what the controller holds; nothing
+ * with a pad hook. */
+void xemu_reference_pad(uint16_t *buttons, int16_t *axis);
+
+/* The hook at a guest address (XEMU_REFERENCE_HOOK_*), NONE when there is none or the run is not a
+ * reference's: the translator asks it of each instruction. */
+int xemu_reference_hook_at(uint32_t address);
+
+/* Whether the run has a hook of that kind. */
+bool xemu_reference_hooked(int hook);
+
+/* What the hooks answer: a present counted; the counter, the milliseconds and the date (100 ns units
+ * since 1601) of the frames presented; the pad script's state for the frame. */
+void xemu_reference_swap(void);
+uint64_t xemu_reference_counter(void);
+uint32_t xemu_reference_ticks(void);
+uint64_t xemu_reference_date(void);
+void xemu_reference_pad_state(uint8_t state[XEMU_REFERENCE_PAD_STATE]);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
