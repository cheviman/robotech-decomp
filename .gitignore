# Bring your own game: its files never go into the repository (the folder at the root; src/game/ is
# the game's C written by hand, which does)
/game/
/RB-XBE/
/Robotech_Battlecry_PS2_ISO_USA/
*.rar
*.zip
*.7z
*.xbe
*.iso
*.xiso
*.rvz
*.gcm

# Everything generated from the game: the pipeline's analysis (a copy of the XBE, disassembly, function and
# ABI databases, run logs and frame dumps) and the recompiled C
/analysis/
/src/recomp/gen/

# Build output
build/
__pycache__/

# What the runtime writes to the working directory
*.log

# Local Claude Code settings
.claude/settings.local.json
.claude/scheduled_tasks.lock
